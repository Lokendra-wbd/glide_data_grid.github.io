# Copy to .env and adjust. Restart dev server after changes.

# Enable/disable bulk event generator
VITE_BULK_ENABLED=true

# Comma-separated years for bulk data (add more as needed: 2027,2028,2029)
VITE_BULK_YEARS=2027,2028

# Max events returned per fetch (prevents UI freeze)
VITE_MAX_EVENTS_PER_FETCH=1200

# 1 = every 30-min slot, 2 = every other slot (half the events)
VITE_BULK_SLOT_DENSITY=1

# Milliseconds to yield to browser between generation chunks
VITE_LOAD_CHUNK_MS=16

# Optional: limit days e.g. Monday,Tuesday,Wednesday
# VITE_BULK_DAYS=
